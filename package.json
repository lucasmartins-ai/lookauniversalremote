{
  "name": "lookaremote-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Universal Remote — Turn any smartphone into an ultra-low-latency wireless controller",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  }
}
